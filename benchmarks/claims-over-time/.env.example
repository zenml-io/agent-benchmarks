# Names of every environment variable this benchmark reads. Put values in work/.env (gitignored) or the shell.

# Claims agent on OpenAI models, and both improvers.
OPENAI_API_KEY=

# Modal environment for the open model, case-file extraction and the classifier.
MODAL_ENVIRONMENT=
# Optional Modal names (defaults in harness/extract/serve.py and harness/hicric/hicric_modal.py).
MODAL_APP_PREFIX=
MODAL_HF_CACHE_VOLUME=
MODAL_VLLM_CACHE_VOLUME=
MODAL_FLASHINFER_CACHE_VOLUME=
MODAL_HICRIC_VOLUME=

# The open model's OpenAI-compatible endpoint (serving "agent-model"), needed from the switch round on.
CLAIMS_AGENT_BASE_URL=

# ZenML Pro arm only: the Kitaru workspace, a ZenML Pro service-account key, the agent bundle and its trial image.
KITARU_API_URL=
KITARU_PRO_API_KEY=
PRO_AGENT_DIR=
PRO_BASE_IMAGE=
PRO_ROUND_IMAGE=

# Optional: where fetched data, case files and runs go (default: ./work).
CLAIMS_WORK_DIR=
