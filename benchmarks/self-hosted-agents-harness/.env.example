# Modal credentials (paid steps only: deploy, sandboxes). Create a token with `modal token new`.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
# Modal environment for GPU servers and Harbor sandboxes (default: main)
MODAL_ENVIRONMENT=
# Prefix of the Modal app names: <prefix>-<config>[-s<slot>] (default: agent)
MODAL_APP_PREFIX=
# Modal volumes for model weights and compile caches (defaults: hf-cache, vllm-cache, flashinfer-cache)
MODAL_HF_CACHE_VOLUME=
MODAL_VLLM_CACHE_VOLUME=
MODAL_FLASHINFER_CACHE_VOLUME=
# archive_jobs.sh only: private volume for raw run directories (no default)
MODAL_RAW_VOLUME=
# Where experiment.py keeps tasks, attempts.jsonl and jobs/ (default: current directory)
BENCH_DIR=
# Override the rows file experiment.py reads and appends to (default: $BENCH_DIR/attempts.jsonl)
ATTEMPTS_FILE=
# GPU dollars already spent outside attempts.jsonl, counted by the --budget guard (default 0)
SPENT_BEFORE=
