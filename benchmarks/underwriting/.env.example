# Names only; never commit values. Load with e.g. `set -a; . ./.env; set +a`.

# Anthropic models (agent, simulated underwriter Haiku 5.5, judge Haiku 5.5, optimizer Opus 5.5)
EVAL_ANTHROPIC_API_KEY=
# OpenAI models (agent, judges GPT-6 Luna and GPT-6.1 Sol)
OPENAI_API_KEY=
# Open-weight models (keys ending in @provider-a): any OpenAI-compatible chat-completions endpoint
OPENAI_COMPAT_BASE_URL_PROVIDER_A=
OPENAI_COMPAT_API_KEY_PROVIDER_A=

# Step-level screen only (replay/): the Jev judge used by the Kitaru model-swap analyzer, and the Kitaru venv
JEV_API_KEY=
KVENV=

# Kitaru full replay only (kitaru_replay/)
KITARU_API_URL=
UW_AGENT_ID=
UW_HARNESS=

# Optional: interpreter for scripts/fetch_data.sh (default: python)
PYTHON=
