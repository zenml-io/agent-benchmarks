# Haiku Tax: environment variables read by harness/run.py and harness/models.py. No values here; never commit them.

# Closed models (vendor APIs)
EVAL_ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Open-weight models on two OpenAI-compatible inference providers (neutral labels provider-a / provider-b)
OPENAI_COMPAT_BASE_URL_PROVIDER_A=
OPENAI_COMPAT_API_KEY_PROVIDER_A=
# Optional: text before the key in the Authorization header (default "Bearer ")
OPENAI_COMPAT_AUTH_PREFIX_PROVIDER_A=
OPENAI_COMPAT_BASE_URL_PROVIDER_B=
OPENAI_COMPAT_API_KEY_PROVIDER_B=
OPENAI_COMPAT_AUTH_PREFIX_PROVIDER_B=

# Jev pre-action check arms (--arm jev / jev2 / jev3) only
JEV_API_KEY=
# Optional: override the Jev endpoint
JEV_API_URL=

# Optional: spend already made elsewhere, counted against harness/grid.py --cap (default 0)
HT_SPENT_BEFORE=
