# Model swap on recorded traffic: environment variables. No values here; never commit them.
EVAL_ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_COMPAT_BASE_URL_PROVIDER_A=
OPENAI_COMPAT_API_KEY_PROVIDER_A=
# Optional: text before the key in the Authorization header (default "Bearer ")
OPENAI_COMPAT_AUTH_PREFIX_PROVIDER_A=
# Judge used by the analyzer for disagreeing replies
JEV_API_KEY=
# Optional: where the Haiku Tax harness and its full-run result rows are (defaults ../haiku-tax and ../haiku-tax/results)
HAIKU_TAX_DIR=
HAIKU_TAX_RESULTS=
