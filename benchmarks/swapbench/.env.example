# SwapBench environment variables. Names only; never commit values. Free checks (RERUN.md sections 3-5) need none.

# --- Model APIs (paid steps) ---
OPENAI_API_KEY=                 # OpenAI agents (GPT-5, GPT-5 mini, GPT-6 Luna, GPT-5.4 nano), next-step runs, coding-agent arm (Codex)
EVAL_ANTHROPIC_API_KEY=         # Claude Haiku 5.5 (simulated customer in every run; retail incumbent); copied to ANTHROPIC_API_KEY by the scripts
ANTHROPIC_API_KEY=              # used directly if EVAL_ANTHROPIC_API_KEY is unset

# --- Hosted open models on commercial inference providers (neutral labels; see providers.example.json) ---
OPENAI_COMPAT_BASE_URL_PROVIDER_A=
OPENAI_COMPAT_API_KEY_PROVIDER_A=
OPENAI_COMPAT_BASE_URL_PROVIDER_B=
OPENAI_COMPAT_API_KEY_PROVIDER_B=
OPENAI_COMPAT_BASE_URL_PROVIDER_C=
OPENAI_COMPAT_API_KEY_PROVIDER_C=
OPENAI_COMPAT_BASE_URL_PROVIDER_D=
OPENAI_COMPAT_API_KEY_PROVIDER_D=
PROVIDERS_CONFIG=               # path to providers.json (label -> model id per model key); default ./providers.json
SWAPBENCH_PROVIDER_PRICES=      # optional JSON {"<litellm model string>": [input, cached, output]} USD per 1M tokens

# --- Jev (TypeSafe) checks: jev_gate / decider_gate agents ---
JEV_API_KEY=                    # or TYPESAFE_API_KEY
SWAPBENCH_JEV_MODEL=            # default jev-latest
SWAPBENCH_JEV_MIN_CONF=         # default 0.7
SWAPBENCH_JEV_MIN_CONF_ESCALATE=  # default 0.5

# --- Run configuration ---
SWAPBENCH_FINTECH_DIR=          # fintech data dir (tasks.json, split_tasks.json, db.json, policy.md)
TAU2_DATA_DIR=                  # tau2 data root holding tau2/domains/retail for generated retail sets
SWAPBENCH_GUARDS=               # 1 = hard guardrails in the fintech tools (fix loop)
SWAPBENCH_POLICY_ADDENDUM=      # path to a file appended to the fintech policy (fix loop: swapbench/fintech/policy_addendum.md)
SWAPBENCH_MACRO=                # 1 = verify_identity also returns accounts and 365 days of transactions
SWAPBENCH_GENMOCK=              # path to a trace-inferred mock.py, served as <domain>_gen
SWAPBENCH_GENMOCK_DOMAIN=       # fintech | retail
SWAPBENCH_JEV= SWAPBENCH_HYBRID=  # 1 = register the jev_gate / jev_route, split, decider_gate agents
SWAPBENCH_JEV_LOG= SWAPBENCH_CALL_LOG=  # decision log and agent call log paths
SWAPBENCH_FALLBACK_LLM=         # jev_route fallback model (default gpt-5-2025-08-07)
SWAPBENCH_DECIDER=              # outcome_gate agent: pickle from scripts/train_outcome_decider.py
CHROME=                         # Chrome/Chromium binary for swap_report.py --pdf

# --- Self-hosted open models and LoRA (Modal) ---
MODAL_ENVIRONMENT=              # your Modal environment; credentials come from your modal config
SWAPBENCH_SERVING_DIR=          # directory with serve_vllm.py + experiment.py (vLLM server on Modal; not in this benchmark)
SWAPBENCH_HF_CACHE_VOLUME= SWAPBENCH_RFT_VOLUME= SWAPBENCH_RFT_APP=
JOBS_DIR=                       # Harbor jobs dir for scripts/run_arm.sh (default ./jobs)
