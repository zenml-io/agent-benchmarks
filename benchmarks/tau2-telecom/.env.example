# Names only. The free checks (install, fetch data, rebuild results) need none of these.

# Paid steps: OpenAI models (agent arms, GPT-5.2 reference, tau2's gpt-4.1 user simulator).
OPENAI_API_KEY=

# Paid steps: the open-weight models (Qwen3.8 27B, Kimi K3, GLM-5.3, DeepSeek V4.1 Flash) on an
# OpenAI-compatible endpoint. Base URL ends in /v1.
OPENAI_COMPAT_BASE_URL_PROVIDER_A=
OPENAI_COMPAT_API_KEY_PROVIDER_A=

# Live replay harness (harness/replay).
TAU2_DATA_DIR=            # <tau2-bench checkout at 05736c2>/data
KITARU_API_URL=           # e.g. http://localhost:8000 for a local server
KITARU_API_KEY=           # only when the server uses auth scheme `local`
TAU2_AGENT_VERSION_ID=    # Kitaru agent version id used by run_baseline.py (version 1)
TAU2_KITARU_AGENT_ID=     # Kitaru agent id of tau2-telecom-live, read by collect_replays.py
# Set per agent version on the Kitaru server, not in your shell:
# TAU2_INSTRUCTION_ADDENDUM (version 2), OPENAI_BASE_URL=http://127.0.0.1:8766/v1 (version 3)

# Harbor runs (harbor/, see harbor/README.md) read OPENAI_API_KEY and the two PROVIDER_A variables above from
# this file (--env-file .env). Modal credentials come from `modal token new` (or MODAL_TOKEN_ID / MODAL_TOKEN_SECRET).
