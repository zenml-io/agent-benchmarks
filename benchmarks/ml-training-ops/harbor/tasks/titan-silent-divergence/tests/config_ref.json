{
 "job": {
  "dump_folder": "./outputs",
  "description": "internal 200M reference run"
 },
 "metrics": {
  "log_freq": 1,
  "disable_color_printing": true
 },
 "model": {
  "name": "llama3",
  "flavor": "internal200m",
  "hf_assets_path": "./tests/assets/tokenizer"
 },
 "optimizer": {
  "name": "AdamW",
  "lr": 0.0006,
  "eps": 1e-08
 },
 "lr_scheduler": {
  "warmup_steps": 50,
  "decay_ratio": 0.8,
  "decay_type": "cosine_floor",
  "min_lr_factor": 0.0
 },
 "training": {
  "local_batch_size": 4,
  "seq_len": 1024,
  "max_norm": 0.5,
  "steps": 1000,
  "dataset": "corpus",
  "dataset_path": "/data/corpus",
  "exclude_shards": []
 },
 "parallelism": {
  "data_parallel_shard_degree": -1
 },
 "checkpoint": {
  "enable": false
 },
 "activation_checkpoint": {
  "mode": "none"
 },
 "debug": {
  "seed": 42,
  "deterministic": true
 }
}